{
  "manifest_version": 3,
  "name": "Usuals",
  "version": "0.2.0",
  "description": "Keep your usual events beside Google Calendar's week and day, and drag one onto a time to schedule it.",
  "homepage_url": "https://kfireliyahu.com/calendar-usuals",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://calendar.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "oauth2": {
    "client_id": "85811622726-j101id0isu5lk7rh3g6rn70nd68rcpmu.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events.owned",
      "https://www.googleapis.com/auth/calendar.calendarlist.readonly"
    ]
  },
  "key": ""
}